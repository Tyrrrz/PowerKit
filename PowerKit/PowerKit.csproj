<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="PowerKit.props" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="PowerKit.props" Pack="true" PackagePath="build" />
    <Content
      Include="**/*.cs"
      Exclude="obj/**/*.cs"
      Pack="true"
      PackagePath="contentFiles/cs/any/PowerKit"
      Visible="false"
      BuildAction="compile"
    />
    <Content
      Include="**/*.cs"
      Exclude="obj/**/*.cs"
      Pack="true"
      PackagePath="content/PowerKit"
      Visible="false"
      BuildAction="compile"
    />
  </ItemGroup>
</Project>
